<UserControl x:Class="SizeMonitor.Controls.ReportDeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid Margin="12" MaxWidth="640">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Deliver by" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="_mode" Width="150" SelectedIndex="0" SelectionChanged="OnModeChanged"
                      automation:AutomationProperties.Name="Report delivery method">
                <ComboBoxItem Content="HTTPS webhook" /><ComboBoxItem Content="SMTP email" />
            </ComboBox>
        </StackPanel>
        <Grid x:Name="_webhookPanel" Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="HTTPS endpoint" VerticalAlignment="Center" />
            <TextBox x:Name="_webhook" Grid.Column="1" automation:AutomationProperties.Name="HTTPS webhook endpoint" />
        </Grid>
        <Grid x:Name="_smtpPanel" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="SMTP host" VerticalAlignment="Center" /><TextBox x:Name="_host" Grid.Column="1" Margin="0,2" />
            <TextBlock Grid.Column="2" Text="Port" Margin="10,0,4,0" VerticalAlignment="Center" /><TextBox x:Name="_port" Grid.Column="3" Text="587" Margin="0,2" />
            <TextBlock Grid.Row="1" Text="From" VerticalAlignment="Center" /><TextBox x:Name="_from" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2" />
            <TextBlock Grid.Row="2" Text="Recipients" VerticalAlignment="Center" /><TextBox x:Name="_to" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2" ToolTip="Semicolon-separated addresses" />
            <TextBlock Grid.Row="3" Text="Username" VerticalAlignment="Center" /><TextBox x:Name="_user" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2" />
            <TextBlock Grid.Row="4" Text="Password" VerticalAlignment="Center" /><PasswordBox x:Name="_password" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2" automation:AutomationProperties.Name="SMTP password" />
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.75"
                   Text="Credentials are used for this delivery only and are never saved. Reports may contain sensitive paths only when their creator explicitly included them." />
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="_send" Content="Send report" Click="OnSend" IsEnabled="False" />
            <Button x:Name="_cancel" Content="Cancel" Click="OnCancel" IsEnabled="False" Margin="8,0,0,0" />
            <ProgressBar x:Name="_progress" Width="100" Height="4" Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>
        <TextBlock x:Name="_status" Grid.Row="5" Margin="0,8,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" automation:AutomationProperties.Name="Report delivery status" />
    </Grid>
</UserControl>
