<UserControl x:Class="SizeMonitor.Controls.ObservabilitySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Privacy and diagnostics settings">
  <Grid Margin="16" MaxWidth="760" HorizontalAlignment="Left">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Privacy and diagnostics" />
    <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap"
               Text="Both reporting options are off by default. Telemetry contains only coarse buckets—never paths or filenames. Crash previews omit messages and source-file locations." />
    <StackPanel Grid.Row="2">
      <CheckBox x:Name="_crashReports" Content="Allow consent-gated crash report submission" Margin="0,4" />
      <CheckBox x:Name="_performance" Content="Allow coarse performance telemetry" Margin="0,4" />
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Diagnostic log level" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="_logLevel" Width="150" SelectedIndex="1"
                  AutomationProperties.Name="Diagnostic log level">
          <ComboBoxItem Content="Off" /><ComboBoxItem Content="Error" />
          <ComboBoxItem Content="Information" /><ComboBoxItem Content="Trace" />
        </ComboBox>
      </StackPanel>
    </StackPanel>
    <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"
               Text="Enabling consent does not silently upload existing data. Any future network submission still uses HTTPS and can be previewed before sending." />
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="Save settings" Click="OnSave" Padding="12,4" />
      <Button Content="Disable and delete local data" Click="OnDisableAndDelete"
              Padding="12,4" Margin="8,0,0,0" />
    </StackPanel>
    <TextBlock x:Name="_status" Grid.Row="5" Margin="0,10,0,0" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
