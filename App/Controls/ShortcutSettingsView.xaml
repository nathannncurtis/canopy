<UserControl x:Class="SizeMonitor.Controls.ShortcutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="Keyboard shortcut settings">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Keyboard shortcuts" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,12" Text="Select a command, type a shortcut such as Ctrl+Shift+S, then apply. Changes take effect immediately." TextWrapping="Wrap" Opacity="0.72"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="_shortcut" Width="190" MaxLength="40" AutomationProperties.Name="New shortcut"/>
            <ui:Button Content="Apply" Margin="8,0,0,0" Click="OnApply" AutomationProperties.Name="Apply shortcut"/>
            <ui:Button Content="Clear" Margin="8,0,0,0" Click="OnClear" AutomationProperties.Name="Remove shortcut"/>
            <ui:Button Content="Reset" Margin="8,0,0,0" Click="OnReset" AutomationProperties.Name="Restore default shortcut"/>
        </StackPanel>
        <DataGrid x:Name="_commands" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                  CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True"
                  AutomationProperties.Name="Commands and shortcuts">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Command" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="Shortcut" Binding="{Binding Shortcut}" Width="*"/>
                <DataGridTextColumn Header="Default" Binding="{Binding DefaultShortcut}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="_status" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Opacity="0.75"/>
    </Grid>
</UserControl>
