<UserControl x:Class="SizeMonitor.Controls.FirstRunTourView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" AutomationProperties.Name="Welcome tour">
  <Border Padding="28" CornerRadius="10" MaxWidth="680" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <StackPanel>
      <TextBlock Text="Welcome to Canopy" FontSize="26" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="_stepLabel" Margin="0,6,0,0" Opacity="0.7" />
      <TextBlock x:Name="_title" Margin="0,18,0,0" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
      <TextBlock x:Name="_body" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Margin="0,14,0,0" Opacity="0.7" TextWrapping="Wrap" Text="Use Left and Right to move between steps, Enter to finish, or Escape to close. You can reopen this tour from Help." />
      <DockPanel Margin="0,22,0,0">
        <ui:Button x:Name="_skip" DockPanel.Dock="Left" Content="Skip tour" Appearance="Secondary" Click="OnSkip" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <ui:Button x:Name="_back" Content="Back" Margin="0,0,8,0" Appearance="Secondary" Click="OnBack" />
          <ui:Button x:Name="_next" Content="Next" Appearance="Primary" Click="OnNext" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
