<UserControl x:Class="SizeMonitor.Controls.ScanComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Scan comparison">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <CheckBox x:Name="_added" Content="Added" IsChecked="True" Margin="0,0,12,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <CheckBox x:Name="_removed" Content="Removed" IsChecked="True" Margin="0,0,12,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <CheckBox x:Name="_moved" Content="Moved" IsChecked="True" Margin="0,0,12,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <CheckBox x:Name="_resized" Content="Resized" IsChecked="True" Margin="0,0,20,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <CheckBox x:Name="_fastestOnly" Content="Fastest-growing folders only"
                      ToolTip="Show the 25 folders with the largest positive growth"
                      AutomationProperties.Name="Show fastest-growing folders only"
                      Checked="OnGrowthFilterChanged" Unchecked="OnGrowthFilterChanged" />
        </WrapPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="_summary" Text="Choose two scan results to compare."
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Comparison summary" />
            <TextBlock x:Name="_warning" Foreground="DarkOrange" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Comparison ambiguity warning" />
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="Changes">
                <DataGrid x:Name="_changes" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          MouseDoubleClick="OnChangeDoubleClick"
                          KeyDown="OnChangeKeyDown"
                          ToolTip="Double-click a change to activate it in a scan"
                          AutomationProperties.Name="Changed scan items">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Change" Binding="{Binding Kind}" Width="90" />
                        <DataGridTextColumn Header="Current path" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="Previous path" Binding="{Binding PreviousPath}" Width="*" />
                        <DataGridTextColumn Header="Previous bytes" Binding="{Binding PreviousSize, StringFormat=N0}" Width="115" />
                        <DataGridTextColumn Header="Current bytes" Binding="{Binding CurrentSize, StringFormat=N0}" Width="115" />
                        <DataGridTextColumn Header="Delta" Binding="{Binding SizeDelta, StringFormat=+0;-0;0}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Folder growth">
                <DataGrid x:Name="_growth" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          MouseDoubleClick="OnGrowthDoubleClick"
                          KeyDown="OnGrowthKeyDown"
                          ToolTip="Double-click a folder to activate it in a scan"
                          AutomationProperties.Name="Directory growth results">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" />
                        <DataGridTextColumn Header="Previous bytes" Binding="{Binding PreviousSize, StringFormat=N0}" Width="130" />
                        <DataGridTextColumn Header="Current bytes" Binding="{Binding CurrentSize, StringFormat=N0}" Width="130" />
                        <DataGridTextColumn Header="Growth" Binding="{Binding SizeDelta, StringFormat=+0;-0;0}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
