<UserControl x:Class="SizeMonitor.Controls.SizeTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:SizeMonitor.Controls">
    <UserControl.Resources>
        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="MinHeight" Value="{DynamicResource Canopy.TreeItemMinHeight}" />
        </Style>
        <HierarchicalDataTemplate x:Key="NodeTemplate"
                                  DataType="{x:Type local:SizeNodeView}"
                                  ItemsSource="{Binding Children}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="82" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsMarked, Mode=OneWay}"
                          Checked="OnMarkChecked" Unchecked="OnMarkUnchecked"
                          ToolTip="Mark this item for multi-selection"
                          AutomationProperties.Name="Mark item for selection" />
                <TextBlock Grid.Column="1" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Padding="2,0" />

                <ProgressBar Grid.Column="2" Height="8" VerticalAlignment="Center"
                             Margin="4,0"
                             Minimum="0" Maximum="1"
                             Value="{Binding SizeBarFraction, Mode=OneWay}"
                             Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                             Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <TextBlock Grid.Column="3" Text="{Binding LogicalSizeText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Opacity="0.7" FontSize="11" ToolTip="Logical size" />
                <TextBlock Grid.Column="4" Text="{Binding AllocatedSizeText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                           Opacity="0.7" FontSize="11" ToolTip="Uniquely accounted allocated size (hard links counted once)" />
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <TreeView x:Name="_tree"
              FontSize="{DynamicResource Canopy.TreeFontSize}"
              ItemTemplate="{StaticResource NodeTemplate}"
              Background="Transparent" BorderThickness="0"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              MouseDoubleClick="OnMouseDoubleClick"
              PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
              PreviewMouseMove="OnPreviewMouseMove"
              PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
              KeyDown="OnKeyDown"
              SelectedItemChanged="OnSelectedItemChanged" />
</UserControl>
