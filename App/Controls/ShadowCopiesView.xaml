<UserControl x:Class="SizeMonitor.Controls.ShadowCopiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="Windows shadow copies">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Previous versions" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Browse existing Windows Volume Shadow Copy snapshots. Canopy never deletes or changes snapshots from this view."
                 Margin="0,4,0,12" TextWrapping="Wrap" Opacity="0.72"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <ui:Button Content="Refresh" Click="OnRefresh" Margin="0,0,10,0" AutomationProperties.Name="Refresh shadow copies"/>
      <CheckBox x:Name="_compare" Content="Compare with current live result" VerticalAlignment="Center"/>
    </WrapPanel>
    <DataGrid x:Name="_items" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Available shadow copies">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Volume" Binding="{Binding DriveRoot}" Width="90"/>
        <DataGridTextColumn Header="Created" Binding="{Binding CreatedUtc, StringFormat=g}" Width="180"/>
        <DataGridTextColumn Header="Snapshot ID" Binding="{Binding Id}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <ui:Button Content="Scan selected snapshot" DockPanel.Dock="Right" Click="OnScan" AutomationProperties.Name="Scan selected shadow copy"/>
      <TextBlock x:Name="_status" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
  </Grid>
</UserControl>
