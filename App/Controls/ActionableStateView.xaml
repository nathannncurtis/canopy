<UserControl x:Class="SizeMonitor.Controls.ActionableStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AutomationProperties.Name="Status and available actions">
    <Border Padding="24" CornerRadius="8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel HorizontalAlignment="Center" MaxWidth="620">
            <TextBlock x:Name="_category" HorizontalAlignment="Center" Margin="0,0,0,8"
                       FontSize="13" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock x:Name="_title" HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="_message" HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="_details" HorizontalAlignment="Center" TextAlignment="Left"
                       Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas"
                       Visibility="Collapsed" AutomationProperties.Name="Error details" />
            <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                <ui:Button x:Name="_primary" Margin="0,0,8,0" Click="OnPrimary"
                           AutomationProperties.Name="Primary recovery action" />
                <ui:Button x:Name="_secondary" Appearance="Secondary" Click="OnSecondary"
                           AutomationProperties.Name="Secondary recovery action" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
