<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SizeMonitor</RootNamespace>
    <AssemblyName>Canopy</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Nathan Curtis</Authors>
    <Product>Canopy</Product>
    <AssemblyTitle>Canopy</AssemblyTitle>
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interop\SizeMonitor.Interop.csproj" />
    <ProjectReference Include="..\Cli\SizeMonitor.Cli.csproj" ReferenceOutputAssembly="false" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <Target Name="CopyIsolationWorker" AfterTargets="Build">
    <ItemGroup>
      <IsolationWorkerFiles Include="..\Cli\bin\$(Configuration)\net9.0-windows\canopy-cli.exe" />
      <IsolationWorkerFiles Include="..\Cli\bin\$(Configuration)\net9.0-windows\canopy-cli.dll" />
      <IsolationWorkerFiles Include="..\Cli\bin\$(Configuration)\net9.0-windows\canopy-cli.deps.json" />
      <IsolationWorkerFiles Include="..\Cli\bin\$(Configuration)\net9.0-windows\canopy-cli.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(IsolationWorkerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
