<ui:FluentWindow x:Class="SizeMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:SizeMonitor.Controls"
        Title="Size Monitor"
        Height="700" Width="1100" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontSize="{DynamicResource Canopy.FontSize}"
        AllowDrop="True" DragOver="OnFileDragOver" Drop="OnFileDrop"
        Foreground="{DynamicResource Canopy.WindowForegroundBrush}"
        Background="{DynamicResource Canopy.WindowBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: title bar -->
        <ui:TitleBar Grid.Row="0" x:Name="_titleBar" Title="Size Monitor" />

        <!-- Row 1: toolbar -->
        <Grid Grid.Row="1" x:Name="_toolbar" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        x:Name="_pathBox"
                        PlaceholderText="Enter paths separated by semicolons (local, mapped, or \\server\share)" />
            <Border x:Name="_pathPrivacyMask" Grid.Column="0" Panel.ZIndex="10"
                    Background="#FF303030" CornerRadius="4" Padding="10,5"
                    IsHitTestVisible="False">
                <TextBlock Text="Sensitive paths hidden for screenshots" Foreground="White"
                           VerticalAlignment="Center" />
            </Border>

            <ui:Button Grid.Column="1"
                       x:Name="_btnScan"
                       Content="Scan"
                       Appearance="Primary"
                       Margin="8,0,0,0"
                       Click="OnScan" />

            <ui:Button Grid.Column="2"
                       x:Name="_btnPause"
                       Content="Pause"
                       Margin="8,0,0,0"
                       IsEnabled="False"
                       Click="OnPause" />

            <ui:Button Grid.Column="3"
                       x:Name="_btnCancel"
                       Content="Cancel"
                       Margin="8,0,0,0"
                       IsEnabled="False"
                       Click="OnCancel" />

            <Menu Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center">
                <MenuItem Header="_File">
                    <MenuItem x:Name="_openSnapshotMenuItem" Header="_Open snapshot..."
                              Click="OnOpenSnapshot" />
                    <MenuItem x:Name="_saveSnapshotMenuItem" Header="_Save snapshot..."
                              IsEnabled="False" Click="OnSaveSnapshot" />
                    <Separator />
                    <MenuItem x:Name="_exportMenuItem" Header="_Export results..."
                              IsEnabled="False" Click="OnExport" />
                    <MenuItem x:Name="_copySummaryMenuItem" Header="Copy shareable _summary"
                              IsEnabled="False" Click="OnCopySummary" />
                    <MenuItem x:Name="_diagnosticsMenuItem" Header="Export _diagnostics..."
                              Click="OnExportDiagnostics" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="Help and _concepts" Click="OnOpenHelp" />
                    <MenuItem Header="_Welcome tour" Click="OnOpenTour" />
                    <Separator />
                    <MenuItem Header="Check for _updates..." Click="OnOpenUpdates" />
                </MenuItem>
            </Menu>

            <ui:InfoBadge Grid.Column="5"
                          x:Name="_elevBadge"
                          Severity="Caution"
                          ToolTip="Running without elevation (MFT scan unavailable)"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center" />
            <CheckBox Grid.Column="6" x:Name="_screenshotPrivacyToggle"
                      Content="Screenshot privacy" IsChecked="True"
                      Margin="12,0,0,0" VerticalAlignment="Center"
                      Checked="OnScreenshotPrivacyChanged" Unchecked="OnScreenshotPrivacyChanged" />
        </Grid>

        <Expander Grid.Row="2" x:Name="_scanOptions" Header="Scan options" Margin="12,0,12,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Excluded paths/globs" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="_excludePatternsBox"
                         Margin="8,2,16,2" ToolTip="Semicolon-separated names or relative-path globs" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Excluded extensions" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="_excludeExtensionsBox"
                         Margin="8,2,0,2" ToolTip="Semicolon-separated extensions, such as .tmp;.log" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum size" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="_minimumSizeBox"
                         Margin="8,2,16,2" ToolTip="Examples: 10 MB or 512 KiB" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Maximum size" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="_maximumSizeBox"
                         Margin="8,2,0,2" ToolTip="Leave empty for no limit" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Maximum depth" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="_maximumDepthBox"
                         Margin="8,2,16,2" ToolTip="Leave empty for unlimited depth" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Worker threads" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="_workerThreadsBox"
                         Margin="8,2,0,2" ToolTip="1–1024; leave empty for automatic" />

                <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0">
                    <CheckBox x:Name="_excludeHidden" Content="Exclude hidden" Margin="0,0,16,0" />
                    <CheckBox x:Name="_excludeSystem" Content="Exclude system" Margin="0,0,16,0" />
                    <CheckBox x:Name="_excludeTemporary" Content="Exclude temporary" Margin="0,0,16,0" />
                    <CheckBox x:Name="_excludeReparse" Content="Exclude reparse points" />
                </WrapPanel>
                <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" x:Name="_consistentSnapshot"
                          Content="Use a consistent VSS snapshot (local drives; requires administrator)"
                          Margin="0,6,0,0" ToolTip="Creates a session snapshot so locked and changing files are scanned consistently. Canopy does not delete snapshots." />
            </Grid>
        </Expander>

        <!-- Row 2: exploration and search -->
        <TabControl Grid.Row="3" x:Name="_contentTabs" BorderThickness="0">
          <TabItem Header="Explore">
           <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="_treeColumn" Width="2*" />
                <ColumnDefinition x:Name="_splitterColumn" Width="5" />
                <ColumnDefinition x:Name="_treemapColumn" Width="3*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="12,8">
                <controls:WorkspaceLayoutBar x:Name="_workspaceLayoutBar" DockPanel.Dock="Right"
                                             Margin="12,0,0,0"
                                             ModeRequested="OnWorkspaceModeRequested"
                                             DetachRequested="OnWorkspaceDetachRequested"
                                             FullScreenRequested="OnWorkspaceFullScreenRequested" />
                <controls:ScanNavigationBar x:Name="_navigationBar"
                                            NodeActivated="OnNavigationNodeActivated" />
            </DockPanel>

            <controls:ActionableStateView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                          x:Name="_resultState" Margin="12,4,12,8"
                                          Visibility="Collapsed"
                                          PrimaryActionRequested="OnResultStatePrimary"
                                          SecondaryActionRequested="OnResultStateSecondary" />

            <controls:SelectionActionsBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                          x:Name="_selectionActionsBar"
                                          ActionRequested="OnSelectionActionRequested" />

            <controls:TreemapPresentationBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                             x:Name="_treemapPresentationBar"
                                             PreferencesChanged="OnTreemapPresentationChanged"
                                             ResetRequested="OnTreemapResetRequested" />

            <Border Grid.Row="4" Grid.Column="0"
                    x:Name="_treeHost"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />

            <!-- column separator -->
            <GridSplitter Grid.Row="4" Grid.Column="1" x:Name="_panelSplitter"
                          Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          Background="{DynamicResource CardStrokeColorDefaultBrush}"
                          AutomationProperties.Name="Resize tree and treemap panels" />

            <Border Grid.Row="4" Grid.Column="2"
                    x:Name="_treemapHost" />

           </Grid>
          </TabItem>
          <TabItem Header="Summary">
            <controls:DiskUsageSummaryView x:Name="_diskUsageSummaryView"
                                           NodeActivated="OnSummaryNodeActivated" />
          </TabItem>
          <TabItem Header="Search">
            <controls:SearchResultsView x:Name="_searchView"
                                        NodeActivated="OnSearchNodeActivated" />
          </TabItem>
          <TabItem Header="Empty Items">
            <controls:EmptyItemsView x:Name="_emptyItemsView"
                                     NodeActivated="OnEmptyItemActivated" />
          </TabItem>
          <TabItem Header="Distribution">
            <controls:StorageDistributionView x:Name="_distributionView" />
          </TabItem>
          <TabItem Header="Locations">
            <controls:LocationHistoryView x:Name="_locationHistoryView"
                                          PathActivated="OnHistoryPathActivated" />
          </TabItem>
          <TabItem Header="Previous Versions" GotFocus="OnShadowCopiesFocused">
            <controls:ShadowCopiesView x:Name="_shadowCopiesView" ScanRequested="OnShadowScanRequested" />
          </TabItem>
          <TabItem Header="Monitoring">
            <controls:StorageMonitoringView />
          </TabItem>
          <TabItem Header="Shortcuts">
            <controls:ShortcutSettingsView x:Name="_shortcutSettingsView" />
          </TabItem>
          <TabItem Header="Privacy">
            <controls:ObservabilitySettingsView x:Name="_observabilitySettingsView" />
          </TabItem>
          <TabItem Header="Appearance">
            <controls:AppearanceSettingsView x:Name="_appearanceSettingsView"
                                             PreferencesApplied="OnAppearancePreferencesApplied" />
          </TabItem>
          <TabItem Header="Updates">
            <controls:UpdateSettingsView x:Name="_updateSettingsView" />
          </TabItem>
          <TabItem Header="Compare">
            <controls:ScanComparisonView x:Name="_comparisonView"
                                         NodeActivated="OnComparisonNodeActivated" />
          </TabItem>
          <TabItem Header="Anomalies">
            <controls:ScanAnomaliesView x:Name="_anomaliesView"
                                        NodeActivated="OnAnomalyNodeActivated" />
          </TabItem>
          <TabItem Header="Cleanup">
            <controls:CleanupRulesView x:Name="_cleanupRulesView"
                                       NodeActivated="OnCleanupNodeActivated" />
          </TabItem>
          <TabItem Header="Duplicates">
            <controls:DuplicateFilesView x:Name="_duplicatesView"
                                         PathActivated="OnDuplicatePathActivated" />
          </TabItem>
          <TabItem x:Name="_helpTab" Header="Help">
            <controls:ContextualHelpView x:Name="_contextualHelpView" />
          </TabItem>
        </TabControl>

        <!-- Row 3: status bar -->
        <Border Grid.Row="4" x:Name="_statusBar"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid Margin="12,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ui:TextBlock x:Name="_statSize" Text="No scan" />
                    <ui:TextBlock Text=" | " Appearance="Secondary" />
                    <ui:TextBlock x:Name="_statFiles" Text="" />
                    <ui:TextBlock x:Name="_statTimeSep" Text=" | " Appearance="Secondary" Visibility="Collapsed" />
                    <ui:TextBlock x:Name="_statTime" Text="" />
                    <ui:TextBlock x:Name="_statScannerSep" Text=" | " Appearance="Secondary" Visibility="Collapsed" />
                    <ui:TextBlock x:Name="_statScanner" Text="" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" x:Name="_scanProgress"
                                 Height="4" Minimum="0" Maximum="100"
                                 Visibility="Collapsed" />
                    <ui:TextBlock Grid.Column="1" x:Name="_statCurrent"
                                  Margin="8,0,0,0" Appearance="Secondary"
                                  TextTrimming="CharacterEllipsis" />
                </Grid>
                <ui:TextBlock Grid.Row="2" x:Name="_statVolume"
                              Margin="0,4,0,0" Appearance="Secondary"
                              TextTrimming="CharacterEllipsis" />
                <ui:TextBlock Grid.Row="3" x:Name="_statSelection"
                              Margin="0,4,0,0" Appearance="Secondary"
                              TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        <Border x:Name="_screenshotPrivacyOverlay" Grid.Row="2" Grid.RowSpan="3"
                Panel.ZIndex="100" Background="#FFF3F3F3" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Screenshot privacy is on" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Paths, filenames, scan options, and results are masked."
                           Margin="0,8,0,0" Opacity="0.7" />
            </StackPanel>
        </Border>
        <Border x:Name="_commandPaletteOverlay" Grid.Row="0" Grid.RowSpan="5"
                Panel.ZIndex="200" Background="#99000000" Visibility="Collapsed"
                Padding="160,80" MouseDown="OnCommandPaletteBackdrop">
            <controls:CommandPalette x:Name="_commandPalette" VerticalAlignment="Top"
                                     MaxHeight="480" CloseRequested="OnCommandPaletteCloseRequested" />
        </Border>
        <Grid x:Name="_fullScreenTreemapOverlay" Grid.Row="0" Grid.RowSpan="5"
              Panel.ZIndex="250" Background="Black" Visibility="Collapsed">
            <Border x:Name="_fullScreenTreemapHost" />
            <Button Content="Exit full screen" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12" Padding="12,5" Click="OnWorkspaceFullScreenButton"
                    ToolTip="Exit full-screen treemap (F11 or Escape)"
                    AutomationProperties.Name="Exit full-screen treemap" />
        </Grid>
        <Border x:Name="_tourOverlay" Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="300"
                Background="#B0000000" Visibility="Collapsed" Padding="80">
            <controls:FirstRunTourView x:Name="_firstRunTour" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Completed="OnTourCompleted" Dismissed="OnTourDismissed" />
        </Border>
    </Grid>
</ui:FluentWindow>
