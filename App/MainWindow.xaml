<ui:FluentWindow x:Class="SizeMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:SizeMonitor.Controls"
        Title="Size Monitor"
        Height="700" Width="1100" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: title bar -->
        <ui:TitleBar Grid.Row="0" Title="Size Monitor" />

        <!-- Row 1: toolbar -->
        <Grid Grid.Row="1" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        x:Name="_pathBox"
                        PlaceholderText="Enter paths separated by semicolons (local, mapped, or \\server\share)" />

            <ui:Button Grid.Column="1"
                       x:Name="_btnScan"
                       Content="Scan"
                       Appearance="Primary"
                       Margin="8,0,0,0"
                       Click="OnScan" />

            <ui:Button Grid.Column="2"
                       x:Name="_btnPause"
                       Content="Pause"
                       Margin="8,0,0,0"
                       IsEnabled="False"
                       Click="OnPause" />

            <ui:Button Grid.Column="3"
                       x:Name="_btnCancel"
                       Content="Cancel"
                       Margin="8,0,0,0"
                       IsEnabled="False"
                       Click="OnCancel" />

            <Menu Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center">
                <MenuItem Header="_File">
                    <MenuItem x:Name="_openSnapshotMenuItem" Header="_Open snapshot..."
                              Click="OnOpenSnapshot" />
                    <MenuItem x:Name="_saveSnapshotMenuItem" Header="_Save snapshot..."
                              IsEnabled="False" Click="OnSaveSnapshot" />
                    <Separator />
                    <MenuItem x:Name="_exportMenuItem" Header="_Export results..."
                              IsEnabled="False" Click="OnExport" />
                    <MenuItem Header="Export _diagnostics..."
                              Click="OnExportDiagnostics" />
                </MenuItem>
            </Menu>

            <ui:InfoBadge Grid.Column="5"
                          x:Name="_elevBadge"
                          Severity="Caution"
                          ToolTip="Running without elevation (MFT scan unavailable)"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center" />
        </Grid>

        <Expander Grid.Row="2" Header="Scan options" Margin="12,0,12,8">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Excluded paths/globs" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="_excludePatternsBox"
                         Margin="8,2,16,2" ToolTip="Semicolon-separated names or relative-path globs" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Excluded extensions" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="_excludeExtensionsBox"
                         Margin="8,2,0,2" ToolTip="Semicolon-separated extensions, such as .tmp;.log" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Minimum size" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="_minimumSizeBox"
                         Margin="8,2,16,2" ToolTip="Examples: 10 MB or 512 KiB" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Maximum size" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="_maximumSizeBox"
                         Margin="8,2,0,2" ToolTip="Leave empty for no limit" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Maximum depth" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="_maximumDepthBox"
                         Margin="8,2,16,2" ToolTip="Leave empty for unlimited depth" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Worker threads" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="_workerThreadsBox"
                         Margin="8,2,0,2" ToolTip="1–1024; leave empty for automatic" />

                <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0">
                    <CheckBox x:Name="_excludeHidden" Content="Exclude hidden" Margin="0,0,16,0" />
                    <CheckBox x:Name="_excludeSystem" Content="Exclude system" Margin="0,0,16,0" />
                    <CheckBox x:Name="_excludeTemporary" Content="Exclude temporary" Margin="0,0,16,0" />
                    <CheckBox x:Name="_excludeReparse" Content="Exclude reparse points" />
                </WrapPanel>
            </Grid>
        </Expander>

        <!-- Row 2: exploration and search -->
        <TabControl Grid.Row="3" x:Name="_contentTabs" BorderThickness="0">
          <TabItem Header="Explore">
           <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <controls:ScanNavigationBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                        x:Name="_navigationBar" Margin="12,8"
                                        NodeActivated="OnNavigationNodeActivated" />

            <Border Grid.Row="1" Grid.Column="0"
                    x:Name="_treeHost"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />

            <!-- column separator -->
            <Border Grid.Row="1" Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource CardStrokeColorDefaultBrush}" />

            <Border Grid.Row="1" Grid.Column="2"
                    x:Name="_treemapHost" />

            <!-- empty state overlay (spans all columns) -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        x:Name="_emptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <ui:SymbolIcon Symbol="HardDrive24" FontSize="48" Opacity="0.4" />
                <ui:TextBlock Text="Select a path and click Scan"
                              FontTypography="Body"
                              Appearance="Secondary"
                              Margin="0,8,0,0" />
            </StackPanel>
           </Grid>
          </TabItem>
          <TabItem Header="Search">
            <controls:SearchResultsView x:Name="_searchView"
                                        NodeActivated="OnSearchNodeActivated" />
          </TabItem>
          <TabItem Header="Empty Items">
            <controls:EmptyItemsView x:Name="_emptyItemsView"
                                     NodeActivated="OnEmptyItemActivated" />
          </TabItem>
        </TabControl>

        <!-- Row 3: status bar -->
        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid Margin="12,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ui:TextBlock x:Name="_statSize" Text="No scan" />
                    <ui:TextBlock Text=" | " Appearance="Secondary" />
                    <ui:TextBlock x:Name="_statFiles" Text="" />
                    <ui:TextBlock x:Name="_statTimeSep" Text=" | " Appearance="Secondary" Visibility="Collapsed" />
                    <ui:TextBlock x:Name="_statTime" Text="" />
                    <ui:TextBlock x:Name="_statScannerSep" Text=" | " Appearance="Secondary" Visibility="Collapsed" />
                    <ui:TextBlock x:Name="_statScanner" Text="" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" x:Name="_scanProgress"
                                 Height="4" Minimum="0" Maximum="100"
                                 Visibility="Collapsed" />
                    <ui:TextBlock Grid.Column="1" x:Name="_statCurrent"
                                  Margin="8,0,0,0" Appearance="Secondary"
                                  TextTrimming="CharacterEllipsis" />
                </Grid>
                <ui:TextBlock Grid.Row="2" x:Name="_statVolume"
                              Margin="0,4,0,0" Appearance="Secondary"
                              TextTrimming="CharacterEllipsis" />
                <ui:TextBlock Grid.Row="3" x:Name="_statSelection"
                              Margin="0,4,0,0" Appearance="Secondary"
                              TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
